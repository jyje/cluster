{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  timezone: "Asia/Seoul",
  schedule: ["* 6-11 * * 1"],
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  automerge: false,

  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ["security"],
  },

  // jyje/skills git-commit-helper: bot commits are "🤖 ci(deps): <title>".
  semanticCommits: "disabled",
  commitMessagePrefix: "🤖 ci(deps):",

  // Scan the source catalog rather than the contents of upstream chart copies.
  ignorePaths: ["helm/**"],

  enabledManagers: ["github-actions", "pip_requirements", "custom.regex"],

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["helm-sources/error-pages.json"],
      matchStrings: [
        '"source"\\s*:\\s*"oci://(?<packageName>[^"\\s]+)"\\s*,\\s*"version"\\s*:\\s*"(?<currentValue>[^"\\s]+)"',
      ],
      depNameTemplate: "error-pages Helm chart",
      datasourceTemplate: "docker",
      versioningTemplate: "semver",
    },
  ],

  packageRules: [
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Runner image changes need review regardless of version classification.
      matchDatasources: ["github-runners"],
      matchPackageNames: ["ubuntu"],
      dependencyDashboardApproval: true,
    },
    {
      matchManagers: ["github-actions"],
      matchDatasources: ["!github-runners"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "actions",
    },
    {
      matchManagers: ["pip_requirements"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "diagram Python dependencies",
    },
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["helm-sources/error-pages.json"],
      pinDigests: false,
      constraints: { helm: "3.21.4", ruby: "3.4.9" },
      postUpgradeTasks: {
        commands: ["ruby scripts/vendor-helm-chart.rb"],
        installTools: { helm: "3.21.4", ruby: "3.4.9" },
        fileFilters: ["helm/error-pages/error-pages-*/**"],
      },
    },
  ],
}
