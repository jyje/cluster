{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  baseBranchPatterns: ["$default"],

  timezone: "Asia/Seoul",
  schedule: ["* 6-11 * * 1"],
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  automerge: false,

  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ["security"],
  },

  // Use the commit subject as the PR title, without extra PR-only suffixes.
  semanticCommits: "disabled",
  prTitleStrict: true,
  commitMessagePrefix: "🤖 ci(deps):",

  // Exclude historical chart trees from general dependency extraction.
  // The native vendor manager adds new version directories from the catalog.
  ignorePaths: ["helm/**"],

  // Stock Renovate shares this policy. The cluster runtime registers the catalog manager.
  enabledManagers: [],
  includePaths: [
    ".github/workflows/**",
    "action.yml",
    "action.yaml",
    "docs/diagrams/requirements.txt",
    "helm-sources/catalog.yaml",
    "tools/renovate/comparison/helm/Chart.yaml",
  ],

  packageRules: [
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Runner image changes need review regardless of version classification.
      matchDatasources: ["github-runners"],
      matchPackageNames: ["ubuntu"],
      dependencyDashboardApproval: true,
    },
    {
      // A referenced action or reusable workflow is a dependency, not a runner.
      matchManagers: ["github-actions"],
      matchDepTypes: ["action", "workflow"],
      commitMessagePrefix: "⬆️ dep(github-actions):",
      commitMessageAction: "bump",
      commitMessageTopic: "{{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      matchDatasources: ["!github-runners"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "actions",
    },
    {
      matchManagers: ["pip_requirements"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "diagram Python dependencies",
    },
    {
      matchManagers: ["helmv3"],
      commitMessagePrefix: "⬆️ dep(helm):",
      commitMessageAction: "bump",
      commitMessageTopic: "{{depName}}",
    },
    {
      matchManagers: ["helm-vendor"],
      matchFileNames: ["helm-sources/catalog.yaml"],
      commitMessagePrefix: "🔧 chore(helm/chart):",
      commitMessageAction: "vendor",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "{{newVersion}}",
      rebaseWhen: "behind-base-branch",
      prBodyNotes: [
        "Adds the selected upstream chart as a new versioned directory. The Argo CD promotion is reviewed separately.",
      ],
    },
  ],
}
