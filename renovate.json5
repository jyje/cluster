{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  baseBranchPatterns: ["$default"],

  timezone: "Asia/Seoul",
  schedule: ["* 6-11 * * 1"],
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  automerge: false,

  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ["security"],
  },

  // jyje/skills git-commit-helper: bot commits are "🤖 ci(deps): <title>".
  semanticCommits: "disabled",
  commitMessagePrefix: "🤖 ci(deps):",

  // Exclude historical chart trees from general dependency extraction.
  // The native vendor manager adds new version directories from the catalog.
  ignorePaths: ["helm/**"],

  // Stock Renovate shares this policy. The cluster runtime registers the catalog manager.
  enabledManagers: [],
  includePaths: [
    ".github/workflows/**",
    "action.yml",
    "action.yaml",
    "docs/diagrams/requirements.txt",
    "helm-sources/catalog.yaml",
    "tools/renovate/comparison/helm/Chart.yaml",
  ],

  packageRules: [
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Runner image changes need review regardless of version classification.
      matchDatasources: ["github-runners"],
      matchPackageNames: ["ubuntu"],
      dependencyDashboardApproval: true,
    },
    {
      matchManagers: ["github-actions"],
      matchDatasources: ["!github-runners"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "actions",
    },
    {
      matchManagers: ["pip_requirements"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "diagram Python dependencies",
    },
    {
      matchFileNames: ["helm-sources/catalog.yaml"],
      commitMessageAction: "Vendor",
      commitMessageTopic: "{{depName}} Helm chart",
      commitMessageExtra: "{{newVersion}}",
      rebaseWhen: "behind-base-branch",
      prBodyNotes: [
        "Adds the selected upstream chart as a new versioned directory. The Argo CD promotion is reviewed separately.",
      ],
    },
  ],
}
